<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BlueprintMaker.Presentation.Avalonia.Views.JambWidthDialog"
        Title="Ширина добора"
        Width="280" Height="140"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="10">
        <TextBlock Text="Ширина добора, мм"/>
        <NumericUpDown x:Name="WidthBox"
                       Minimum="1" Maximum="200" Increment="1"
                       FormatString="0.##"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="OK" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Отмена" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>