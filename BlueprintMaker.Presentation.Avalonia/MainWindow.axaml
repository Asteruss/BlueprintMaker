<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="using:BlueprintMaker.Presentation.Avalonia"
		xmlns:vm="using:BlueprintMaker.Presentation.Avalonia.ViewModels"
		xmlns:views="using:BlueprintMaker.Presentation.Avalonia.Views"
		xmlns:mat="using:BlueprintMaker.Domain.Models.Materialisation"
		mc:Ignorable="d"
		x:Class="BlueprintMaker.Presentation.Avalonia.MainWindow"
		x:DataType="vm:MainViewModel"
		Title="Конструктор"
		WindowStartupLocation="CenterOwner"
		WindowState="Maximized">

	<Window.KeyBindings>
		<KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}"/>
		<KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}"/>
		<KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}"/>
		<KeyBinding Gesture="Ctrl+N" Command="{Binding CreateWindowCommand}"/>
	</Window.KeyBindings>

	<Design.DataContext>
		<vm:MainViewModel/>
	</Design.DataContext>

	<Grid RowDefinitions="Auto, Auto, *" ColumnDefinitions="*, 4*, 1.5*">

		<!-- Меню -->
		<Menu Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
			<MenuItem Header="Файл">
				<MenuItem Header="Открыть" Command="{Binding OpenCommand}"/>
				<MenuItem Header="Сохранить" Command="{Binding SaveCommand}"/>
				<MenuItem Header="Сохранить как…" Command="{Binding SaveAsCommand}"/>
			</MenuItem>
			<MenuItem Header="Создать окно" Command="{Binding CreateWindowCommand}"/>

		</Menu>

		<!-- Панель инструментов -->
		<WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="5"  Grid.Column="0" Grid.ColumnSpan="3">
			<Button Content="Undo"
					Command="{Binding UndoCommand}"
					HotKey="Ctrl+Z"
					Padding="10,2"/>

			<Button Content="Redo"
					Command="{Binding RedoCommand}"
					HotKey="Ctrl+Y"
					Padding="10,2"/>

			<Button Content="Материализова все" Command="{Binding MaterializeAllCommand}"/>

			<TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="10,0,0,0"/>
		</WrapPanel>

		<!-- Дерево элементов -->
		<TreeView Grid.Row="2" Grid.Column="0" ItemsSource="{Binding Frames}" Background="WhiteSmoke">
    <TreeView.Styles>
        <Style Selector="TreeViewItem">
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Padding" Value="8,1"/>
        </Style>
    </TreeView.Styles>

    <TreeView.DataTemplates>
        <!-- Рама -->
        <TreeDataTemplate DataType="vm:FrameViewModel" ItemsSource="{Binding TreeChildren}">
            <Button Command="{Binding SelectCommand}" CommandParameter="{Binding}"
                    Padding="2" Background="Transparent" BorderThickness="0">
                <TextBlock Text="{Binding DisplayName}" Foreground="Black"/>
            </Button>
        </TreeDataTemplate>

        <!-- Доска (сторона + ширина) -->
        <TreeDataTemplate DataType="vm:BoardViewModel">
            <Button Command="{Binding SelectCommand}" CommandParameter="{Binding}"
                    Padding="2" Background="Transparent" BorderThickness="0">
                <TextBlock Text="{Binding DisplayName}" Foreground="DarkSlateGray"/>
            </Button>
        </TreeDataTemplate>

        <!-- Световой проём -->
        <TreeDataTemplate DataType="vm:LightSpaceViewModel" ItemsSource="{Binding TreeChildren}">
            <Button Command="{Binding SelectCommand}" CommandParameter="{Binding}"
                    Padding="2" Background="Transparent" BorderThickness="0">
                <TextBlock Text="Световой проём" Foreground="Gray"/>
            </Button>
        </TreeDataTemplate>

        <!-- Импост -->
        <TreeDataTemplate DataType="vm:ImpostViewModel" ItemsSource="{Binding TreeChildren}">
            <Button Command="{Binding SelectCommand}" CommandParameter="{Binding}"
                    Padding="2" Background="Transparent" BorderThickness="0">
                <TextBlock Text="{Binding DisplayName}" Foreground="Black"/>
            </Button>
        </TreeDataTemplate>

        <!-- Створка -->
        <TreeDataTemplate DataType="vm:SashViewModel" ItemsSource="{Binding TreeChildren}">
            <Button Command="{Binding SelectCommand}" CommandParameter="{Binding}"
                    Padding="2" Background="Transparent" BorderThickness="0">
                <TextBlock Text="Створка" Foreground="Black"/>
            </Button>
        </TreeDataTemplate>

        <!-- Добор -->
        <TreeDataTemplate DataType="vm:JambViewModel">
            <Button Command="{Binding SelectCommand}" CommandParameter="{Binding}"
                    Padding="2" Background="Transparent" BorderThickness="0">
                <TextBlock Text="{Binding DisplayName}" Foreground="DarkGoldenrod"/>
            </Button>
        </TreeDataTemplate>
    </TreeView.DataTemplates>
</TreeView>
		<!-- Холст -->
		<Grid Grid.Row="2" Grid.Column="1" ClipToBounds="True">
			<ItemsControl x:Name="DrawingCanvas" Background="#F9F9F9" ItemsSource="{Binding Frames}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<Panel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
							<Canvas Background="Transparent"
									Width="{Binding $parent[Panel].Bounds.Width}"
									Height="{Binding $parent[Panel].Bounds.Height}"/>
						</Panel>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>

				<ItemsControl.Styles>
					<Style Selector="ItemsControl > ContentPresenter">
						<Setter Property="Canvas.Left" Value="0"/>
						<Setter Property="Canvas.Top" Value="0"/>
					</Style>
				</ItemsControl.Styles>

				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="vm:FrameViewModel">
						<Panel Width="{Binding $parent[Canvas].Bounds.Width}"
							   Height="{Binding $parent[Canvas].Bounds.Height}"
							   RenderTransformOrigin="0.5,0.5">
							<Panel.RenderTransform>
								<TransformGroup>
									<ScaleTransform ScaleX="{ReflectionBinding Zoom, Source={x:Static local:AppSettings.Instance}}"
													ScaleY="{ReflectionBinding Zoom, Source={x:Static local:AppSettings.Instance}}"/>
									<TranslateTransform X="{ReflectionBinding PanX, Source={x:Static local:AppSettings.Instance}}"
														Y="{ReflectionBinding PanY, Source={x:Static local:AppSettings.Instance}}"/>
								</TransformGroup>
							</Panel.RenderTransform>

							<!-- Скелет -->
							<ItemsControl ItemsSource="{Binding Lines}" IsVisible="{Binding !IsMaterialized}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.Styles>
									<Style Selector="ItemsControl > ContentPresenter">
										<Setter Property="Canvas.Left" Value="0"/>
										<Setter Property="Canvas.Top" Value="0"/>
									</Style>
								</ItemsControl.Styles>
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:WireframeLine">
										<Path Data="{Binding Geometry}"
											  Stroke="{Binding StrokeColor}"
											  StrokeThickness="{Binding StrokeThickness}"
											  Fill="Transparent"
											  PointerPressed="ElementPath_PointerPressed"/>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<!-- Доски -->
							<ItemsControl ItemsSource="{Binding Boards}" IsVisible="{Binding IsMaterialized}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.Styles>
									<Style Selector="ItemsControl > ContentPresenter">
										<Setter Property="Canvas.Left" Value="0"/>
										<Setter Property="Canvas.Top" Value="0"/>
									</Style>
								</ItemsControl.Styles>
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:BoardViewModel">
										<Path Data="{Binding Geometry}"
											  Fill="Transparent"
											  Stroke="{Binding FillColor}"
											  StrokeThickness="2"
											  PointerPressed="ElementPath_PointerPressed"/>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>


							<ItemsControl ItemsSource="{Binding Spaces}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.Styles>
									<Style Selector="ItemsControl > ContentPresenter">
										<Setter Property="Canvas.Left" Value="0"/>
										<Setter Property="Canvas.Top" Value="0"/>
									</Style>
								</ItemsControl.Styles>
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:LightSpaceViewModel">
										<Path Data="{Binding Geometry}"
											  Fill="{Binding FillColor}"
											  Stroke="Transparent"
											  StrokeThickness="1"
											  PointerPressed="ElementPath_PointerPressed"/>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<!-- Импосты -->
							<ItemsControl ItemsSource="{Binding Imposts}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.Styles>
									<Style Selector="ItemsControl > ContentPresenter">
										<Setter Property="Canvas.Left" Value="0"/>
										<Setter Property="Canvas.Top" Value="0"/>
									</Style>
								</ItemsControl.Styles>
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:ImpostViewModel">
										<Panel>
											<!-- Скелет (Сегменты) -->
											<ItemsControl ItemsSource="{Binding Segments}" IsVisible="{Binding !IsMaterialized}">
												<ItemsControl.ItemsPanel>
													<ItemsPanelTemplate><Grid/></ItemsPanelTemplate>
												</ItemsControl.ItemsPanel>
												<ItemsControl.ItemTemplate>
													<DataTemplate x:DataType="vm:ImpostSegment">
														<Path Data="{Binding Geometry}"
															  Stroke="{Binding StrokeColor}"
															  StrokeThickness="{Binding StrokeThickness}"
															  Cursor="{Binding DragCursor}"
															  PointerPressed="ElementPath_PointerPressed"/>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>

											<!-- Доски (Материализованный брус) -->
											<ItemsControl ItemsSource="{Binding Boards}" IsVisible="{Binding IsMaterialized}">
												<ItemsControl.ItemsPanel>
													<ItemsPanelTemplate><Grid/></ItemsPanelTemplate>
												</ItemsControl.ItemsPanel>
												<ItemsControl.ItemTemplate>
													<DataTemplate x:DataType="vm:BoardViewModel">
														<Path Data="{Binding Geometry}"
															  Fill="Transparent"
															  Stroke="{Binding FillColor}"
															  StrokeThickness="1"
															  PointerPressed="ElementPath_PointerPressed"/>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>

										</Panel>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<ItemsControl ItemsSource="{Binding Sashes}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.Styles>
									<Style Selector="ItemsControl > ContentPresenter">
										<Setter Property="Canvas.Left" Value="0"/>
										<Setter Property="Canvas.Top" Value="0"/>
									</Style>
								</ItemsControl.Styles>
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:SashViewModel">
										<ItemsControl ItemsSource="{Binding Boards}">
											<ItemsControl.ItemsPanel>
												<ItemsPanelTemplate><Grid/></ItemsPanelTemplate>
											</ItemsControl.ItemsPanel>
											<ItemsControl.ItemTemplate>
												<DataTemplate x:DataType="vm:BoardViewModel">
													<Path Data="{Binding Geometry}"
														  Fill="Transparent"
														  Stroke="{Binding FillColor}"
														  StrokeThickness="1"
														  PointerPressed="ElementPath_PointerPressed"/>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<ItemsControl ItemsSource="{Binding Jambs}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.Styles>
									<Style Selector="ItemsControl > ContentPresenter">
										<Setter Property="Canvas.Left" Value="0"/>
										<Setter Property="Canvas.Top" Value="0"/>
									</Style>
								</ItemsControl.Styles>
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:JambViewModel">
										<Panel>
											<!-- Немaтериализованный: контур -->
											<Path Data="{Binding Outline}"
												  Fill="Transparent"
												  Stroke="{Binding StrokeColor}" StrokeThickness="{Binding StrokeThickness}"
												  IsVisible="{Binding !IsMaterialized}"
												  PointerPressed="ElementPath_PointerPressed"/>

											<ItemsControl ItemsSource="{Binding Boards}" IsVisible="{Binding IsMaterialized}">
												<ItemsControl.ItemsPanel>
													<ItemsPanelTemplate><Grid/></ItemsPanelTemplate>
												</ItemsControl.ItemsPanel>
												<ItemsControl.ItemTemplate>
													<DataTemplate x:DataType="vm:BoardViewModel">
														<Path Data="{Binding Geometry}"
															  Fill="Gray"
															  Stroke="{Binding FillColor}"
															  StrokeThickness="1"
															  PointerPressed="ElementPath_PointerPressed"/>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</Panel>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<ItemsControl ItemsSource="{Binding JambSlots}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.Styles>
									<Style Selector="ItemsControl > ContentPresenter" x:DataType="vm:JambSlotViewModel">
										<Setter Property="Canvas.Left" Value="{Binding Left}"/>
										<Setter Property="Canvas.Top" Value="{Binding Top}"/>
									</Style>
									<Style Selector="Button.jambArrow">
										<Setter Property="Background" Value="Transparent"/>
										<Setter Property="BorderThickness" Value="0"/>
										<Setter Property="Padding" Value="0"/>
										<Setter Property="Cursor" Value="Hand"/>
									</Style>
									<Style Selector="Button.jambArrow:pointerover /template/ ContentPresenter">
										<Setter Property="Background" Value="Transparent"/>
									</Style>
									<Style Selector="Button.jambArrow:pointerover Path">
										<Setter Property="Stroke" Value="#FF1B8F2E"/>
										<Setter Property="StrokeThickness" Value="3.5"/>
									</Style>
								</ItemsControl.Styles>
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:JambSlotViewModel">
										<Button Classes="jambArrow" Width="24" Height="24"
												Command="{Binding AddCommand}"
												CommandParameter="{Binding Slot}"
												ToolTip.Tip="Добавить добор"
												RenderTransformOrigin="50%,50%">
											<Button.RenderTransform>
												<RotateTransform Angle="{Binding Angle}"/>
											</Button.RenderTransform>
											<Path Data="M -9,0 L 9,0 M 2,-7 L 9,0 L 2,7"
												  Stroke="#FF2EA043" StrokeThickness="2.5"
												  StrokeLineCap="Round" StrokeJoin="Round"
												  HorizontalAlignment="Center" VerticalAlignment="Center"/>
										</Button>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<!-- Узлы (Nodes) -->
							<ItemsControl ItemsSource="{Binding Nodes}" IsVisible="{Binding IsNodeVisible, Source={x:Static local:AppSettings.Instance}}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<Canvas />
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.Styles>
									<Style Selector="ItemsControl > ContentPresenter">
										<Setter Property="Canvas.Left" Value="{ReflectionBinding X}"/>
										<Setter Property="Canvas.Top" Value="{ReflectionBinding Y}"/>
									</Style>
								</ItemsControl.Styles>
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:NodeViewModel">
										<Ellipse Width="12" Height="12"
												 Fill="{Binding FillColor}"
												 Stroke="Black"
												 StrokeThickness="1"
												 Margin="-6,-6,0,0"
												 PointerPressed="Node_PointerPressed"/>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<!-- Размерные линии -->
							<ItemsControl ItemsSource="{Binding Dimensions}"
										  IsVisible="{ReflectionBinding IsDimensionsVisible, Source={x:Static local:AppSettings.Instance}}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.Styles>
									<Style Selector="ItemsControl > ContentPresenter">
										<Setter Property="Canvas.Left" Value="0"/>
										<Setter Property="Canvas.Top" Value="0"/>
									</Style>
								</ItemsControl.Styles>
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:DimensionViewModel">
										<Panel>
											<Path Data="{Binding Geometry}"
												  Stroke="{Binding DisplayColor}"
												  StrokeThickness="{Binding StrokeThickness}"
												  Fill="Transparent"/>
											<TextBlock Text="{Binding Text}"
													   Foreground="Black"
													   FontWeight="Bold"
													   FontSize="10"
													   RenderTransformOrigin="0.5,0.5"
													   Margin="-10,-7,0,0">
												<TextBlock.RenderTransform>
													<TransformGroup>
														<RotateTransform Angle="{Binding Angle}"/>
														<TranslateTransform X="{Binding TextX}" Y="{Binding TextY}"/>
													</TransformGroup>
												</TextBlock.RenderTransform>
											</TextBlock>
										</Panel>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>


							<Canvas IsVisible="{Binding IsSelected}">
								<Ellipse Width="16" Height="16"
										 Canvas.Left="{Binding FrameDragHandle.X, FallbackValue=0}"
										 Canvas.Top="{Binding FrameDragHandle.Y, FallbackValue=0}"
										 Fill="LightBlue"
										 Stroke="DarkBlue"
										 StrokeThickness="2"
										 Margin="-8,-8,0,0"
										 Cursor="{Binding FrameDragHandle.DragCursor}"
										 PointerPressed="DragHandle_PointerPressed"/>
							</Canvas>
						</Panel>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
			<Path Data="{Binding GridGeometry}"
				  Stroke="#DCDCDC"
				  StrokeThickness="0.8"
				  Fill="Transparent"
				  IsHitTestVisible="False"
				  IsVisible="{ReflectionBinding IsGridVisible, Source={x:Static local:AppSettings.Instance}}"
				  RenderTransformOrigin="0.5,0.5">
				<Path.RenderTransform>
					<TransformGroup>
						<ScaleTransform ScaleX="{ReflectionBinding Zoom, Source={x:Static local:AppSettings.Instance}}"
										ScaleY="{ReflectionBinding Zoom, Source={x:Static local:AppSettings.Instance}}"/>
						<TranslateTransform X="{ReflectionBinding PanX, Source={x:Static local:AppSettings.Instance}}"
											Y="{ReflectionBinding PanY, Source={x:Static local:AppSettings.Instance}}"/>
					</TransformGroup>
				</Path.RenderTransform>
			</Path>
		</Grid>
		<ScrollViewer Grid.Row="2" Grid.Column="2" Margin="5">
			<TabControl SelectedIndex="1">
				<TabItem Header="Настройки">
					<StackPanel Spacing="10" Margin="5">

						<!-- Узлы -->
						<Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="0,0,0,5">
							<StackPanel Orientation="Horizontal" Spacing="10">
								<TextBlock Text="Узлы" VerticalAlignment="Center" Width="120"/>
								<ToggleSwitch
								IsChecked="{Binding IsNodeVisible, Source={x:Static local:AppSettings.Instance}}"
								OnContent="Вкл" OffContent="Выкл"/>
							</StackPanel>
						</Border>

						<!-- Масштаб -->
						<Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="0,0,0,5">
							<StackPanel Spacing="5">
								<StackPanel Orientation="Horizontal" Spacing="10">
									<TextBlock Text="Масштаб" VerticalAlignment="Center" Width="120"/>
									<TextBlock
									Text="{Binding Zoom, StringFormat={}{0:0%}, Source={x:Static local:AppSettings.Instance}}"
									VerticalAlignment="Center"/>
									<Button Content="Сбросить" Click="ResetZoom_Click" Padding="10,2"/>
								</StackPanel>
								<TextBlock Text="Колесико мышки — изменить" FontSize="11" Foreground="Gray" Margin="120,0,0,0"/>
							</StackPanel>
						</Border>

						<!-- Сетка -->
						<Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="0,0,0,5">
							<StackPanel Spacing="5">
								<StackPanel Orientation="Horizontal" Spacing="10">
									<TextBlock Text="Сетка" VerticalAlignment="Center" Width="120"/>
									<ToggleSwitch
									IsChecked="{Binding IsGridVisible, Source={x:Static local:AppSettings.Instance}}"
									OnContent="Вкл" OffContent="Выкл"/>
								</StackPanel>
								<StackPanel Orientation="Horizontal" Spacing="10" Margin="120,0,0,0"
											IsVisible="{Binding IsGridVisible, Source={x:Static local:AppSettings.Instance}}">
									<TextBlock Text="Размер ячейки:" VerticalAlignment="Center"/>
									<NumericUpDown Value="{Binding GridSize, Source={x:Static local:AppSettings.Instance}}"
												   Minimum="5"
												   Maximum="500"
												   Increment="5"
												   FormatString="N0"
												   Width="110"/>
									<TextBlock Text="мм" VerticalAlignment="Center"/>
								</StackPanel>
							</StackPanel>
						</Border>

						<!-- Подписи размеров -->
						<Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="0,0,0,5">
							<StackPanel Orientation="Horizontal" Spacing="10">
								<TextBlock Text="Габариты" VerticalAlignment="Center" Width="120"/>
								<ToggleSwitch
								IsChecked="{ReflectionBinding IsDimensionsVisible, Source={x:Static local:AppSettings.Instance}}"
								OnContent="Вкл" OffContent="Выкл"/>
							</StackPanel>
						</Border>

					</StackPanel>
				</TabItem>
				<TabItem Header="Функции">
					<ContentControl Content="{Binding SelectedElement}">
						<ContentControl.DataTemplates>
							<!--Wireframe-->
							<DataTemplate DataType="vm:WireframeLine">
								<StackPanel Spacing="5">
									<TextBlock Text="Контур рамы" FontWeight="Bold"/>

									<Button Content="Разбить поровну" Command="{Binding $parent[ScrollViewer].((vm:MainViewModel)DataContext).SplitEqualCommand}" Padding="10,2"/>
									<Button Content="Разбить в точке клика" Command="{Binding $parent[ScrollViewer].((vm:MainViewModel)DataContext).SplitAtClickCommand}" Padding="10,2"/>
									<Button Content="Сделать дугой" Command="{Binding $parent[ScrollViewer].((vm:MainViewModel)DataContext).ToggleArcCommand}"/>

								</StackPanel>
							</DataTemplate>
							<!--Node-->
							<DataTemplate DataType="vm:NodeViewModel">
								<StackPanel>
									<TextBox Text="{Binding X}"/>
									<TextBox Text="{Binding Y}"/>
								</StackPanel>
							</DataTemplate>
							<!--LightSpace-->
							<DataTemplate DataType="vm:LightSpaceViewModel">
								<StackPanel Spacing="5">
									<TextBlock Text="Световое пространство" FontWeight="Bold"/>
									<Button Content="Вставить верт. импост"
											Command="{Binding $parent[ScrollViewer].((vm:MainViewModel)DataContext).InsertVerticalImpostCommand}"
											HorizontalAlignment="Stretch"/>
									<Button Content="Вставить гор. импост"
											Command="{Binding $parent[ScrollViewer].((vm:MainViewModel)DataContext).InsertHorizontalImpostCommand}"
											HorizontalAlignment="Stretch"/>
									<StackPanel Orientation="Horizontal" Spacing="5" Margin="10, 2">
										<NumericUpDown x:Name="ImpostsCountPicker1"
													   Value="2"
													   Minimum="1"
													   Maximum="10"
													   FormatString="0"
													   ParsingNumberStyle="Integer"/>
										<Button Content="Вставить n вертикальных импостов"
												Command="{Binding $parent[ScrollViewer].((vm:MainViewModel)DataContext).InsertMultipleVerticalImpostsCommand}"
												CommandParameter="{Binding #ImpostsCountPicker1.Value}"
												HorizontalAlignment="Stretch"/>
									</StackPanel>
									<StackPanel Orientation="Horizontal" Spacing="5" Margin="10, 2">
										<NumericUpDown x:Name="ImpostsCountPicker2"
													   Value="2"
													   Minimum="1"
													   Maximum="10"
													   FormatString="0"
													   ParsingNumberStyle="Integer"/>
										<Button Content="Вставить n горизонтальных импостов"
												Command="{Binding $parent[ScrollViewer].((vm:MainViewModel)DataContext).InsertMultipleHorizontalImpostsCommand}"
												CommandParameter="{Binding #ImpostsCountPicker2.Value}"
												HorizontalAlignment="Stretch"/>
									</StackPanel>
									<Grid ColumnDefinitions="*,2*">
										<NumericUpDown x:Name="MatSashSize"
													   Value="20"
													   Minimum="5"
													   Maximum="50"
													   ParsingNumberStyle="Integer"
													   Grid.Column="0"/>

										<Button Content="Вставить створку"
												Command="{Binding $parent[ScrollViewer].((vm:MainViewModel)DataContext).InsertSashCommand}"
												CommandParameter="{Binding #MatSashSize.Value}"
												Grid.Column="1"/>
									</Grid>
								</StackPanel>
							</DataTemplate>
							<!--Board-->
							<DataTemplate DataType="vm:BoardViewModel">
								<StackPanel Spacing="5">
									<StackPanel.Styles>
										<Style Selector="Button.start">
											<Setter Property="Command"
													Value="{Binding $parent[ScrollViewer].((vm:MainViewModel)DataContext).SetStartTypeCommand}"/>
										</Style>
										<Style Selector="Button.end">
											<Setter Property="Command"
													Value="{Binding $parent[ScrollViewer].((vm:MainViewModel)DataContext).SetEndTypeCommand}"/>
										</Style>
									</StackPanel.Styles>
									<StackPanel Orientation="Horizontal" Spacing="10">
										<TextBlock Text="{Binding BoardWidth, StringFormat=Ширина: {0:F0} мм}"/>
										<TextBlock Text="{Binding BoardLength, StringFormat=Длина: {0:F0} мм}"/>
									</StackPanel>

									<Separator Margin="0,5"/>
									<TextBlock Text="Стыки доски:" FontWeight="Bold"/>
									<TextBlock Text="Начало:" VerticalAlignment="Center" Margin="5,0,0,0"/>
									<StackPanel Orientation="Horizontal" Spacing="5">
										<Button Classes="start" Content="Ус" CommandParameter="{x:Static mat:JointEndType.Miter}" Padding="10,2"/>
										<Button Classes="start" Content="Шип" CommandParameter="{x:Static mat:JointEndType.Tenon}" Padding="10,2"/>
										<Button Classes="start" Content="Паз"  CommandParameter="{x:Static mat:JointEndType.Mortise}" Padding="10,2"/>
									</StackPanel>
									<TextBlock Text="Конец:" VerticalAlignment="Center" Margin="5,0,0,0"/>
									<StackPanel Orientation="Horizontal" Spacing="5">
										<Button Classes="end" Content="Ус"  CommandParameter="{x:Static mat:JointEndType.Miter}" Padding="10,2"/>
										<Button Classes="end" Content="Шип" CommandParameter="{x:Static mat:JointEndType.Tenon}" Padding="10,2"/>
										<Button Classes="end" Content="Паз" CommandParameter="{x:Static mat:JointEndType.Mortise}" Padding="10,2"/>
									</StackPanel>



								</StackPanel>
							</DataTemplate>
							<!--Frame-->
							<DataTemplate DataType="vm:FrameViewModel">
								<StackPanel Spacing="5">
									<TextBlock Text="Рама" FontWeight="Bold"/>
									<Grid ColumnDefinitions="*,2*">
										<NumericUpDown x:Name="MatSize"
													   Value="20"
													   Minimum="5"
													   Maximum="50"
													   ParsingNumberStyle="Integer"
													   Grid.Column="0"/>

										<Button Content="Материализовать"
												Command="{Binding $parent[ScrollViewer].((vm:MainViewModel)DataContext).MaterializeCommand}"
												CommandParameter="{Binding #MatSize.Value}"
												Grid.Column="1"/>
									</Grid>
								</StackPanel>
							</DataTemplate>

							<!--ImpostSegment-->
							<DataTemplate DataType="vm:ImpostSegment">
								<StackPanel Spacing="5">
									<TextBlock Text="Контур импоста" FontWeight="Bold"/>

									<Button Content="Разбить поровну" Command="{Binding $parent[ScrollViewer].((vm:MainViewModel)DataContext).SplitImpostEqualCommand}"/>
									<Button Content="Разбить в точке клика" Command="{Binding $parent[ScrollViewer].((vm:MainViewModel)DataContext).SplitImpostAtClickCommand}"/>
									<Button Content="Сделать дугой" Command="{Binding $parent[ScrollViewer].((vm:MainViewModel)DataContext).ToggleArcCommand}"/>
									<Separator Margin="0, 5"/>
									<Grid ColumnDefinitions="*,2*">
										<NumericUpDown x:Name="MatSize"
													   Value="20"
													   Minimum="5"
													   Maximum="50"
													   ParsingNumberStyle="Integer"
													   Grid.Column="0"/>

										<Button Content="Материализовать"
												Command="{Binding $parent[ScrollViewer].((vm:MainViewModel)DataContext).MaterializeCommand}"
												CommandParameter="{Binding #MatSize.Value}"
												Grid.Column="1"/>
									</Grid>
								</StackPanel>

							</DataTemplate>
						</ContentControl.DataTemplates>
					</ContentControl>
				</TabItem>
			</TabControl>

		</ScrollViewer>
	</Grid>
</Window>
