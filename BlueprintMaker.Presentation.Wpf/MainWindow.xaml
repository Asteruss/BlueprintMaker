<Window x:Class="BlueprintMaker.Presentation.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BlueprintMaker.Presentation.Wpf"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="5">
            <TextBlock Text="Ширина:" VerticalAlignment="Center"/>
            <TextBox x:Name="WidthBox" Width="40" Text="500" Margin="2"/>
            <TextBlock Text="Высота:" VerticalAlignment="Center"/>
            <TextBox x:Name="HeightBox" Width="40" Text="400" Margin="2"/>
            <Button Content="Создать раму" Click="CreateCustomFrame_Click" Margin="2" Padding="10,2"/>
            <Separator Margin="10,0"/>
            <Button Content="Undo" Click="Undo_Click" Margin="2" Padding="10,2"/>
            <Button Content="Redo" Click="Redo_Click" Margin="2" Padding="10,2"/>
        </StackPanel>

        <Canvas x:Name="DrawingCanvas" Grid.Row="1" Background="White" ClipToBounds="True"
                PreviewMouseRightButtonDown="DrawingCanvas_PreviewMouseRightButtonDown"/>
    </Grid>
</Window>
