<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:BlueprintMaker.Presentation.Avalonia.ViewModels"
		x:Class="BlueprintMaker.Presentation.Avalonia.Views.NewWindowDialog"
		x:DataType="vm:NewWindowDialogViewModel"
		Title="Новое окно"
		Width="700" SizeToContent="Height"
		CanResize="False"
		WindowStartupLocation="CenterOwner">

	<Window.Styles>
		<Style Selector="TextBlock.caption">
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="TextBlock.hint">
			<Setter Property="Opacity" Value="0.6"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>
		<Style Selector="Grid.form">
			<Setter Property="RowSpacing" Value="8"/>
			<Setter Property="ColumnSpacing" Value="8"/>
		</Style>
		<Style Selector="Grid.form > NumericUpDown, Grid.form > ComboBox">
			<Setter Property="Grid.Column" Value="1"/>
			<Setter Property="Width" Value="160"/>
			<Setter Property="HorizontalAlignment" Value="Left"/>
		</Style>
	</Window.Styles>

	<StackPanel Margin="16" Spacing="14">

		<!-- Выбор формы -->
		<ListBox ItemsSource="{Binding Shapes}"
				 SelectedItem="{Binding SelectedShape}"
				 Background="Transparent">
			<ListBox.ItemsPanel>
				<ItemsPanelTemplate>
					<WrapPanel Orientation="Horizontal"/>
				</ItemsPanelTemplate>
			</ListBox.ItemsPanel>
			<ListBox.ItemTemplate>
				<DataTemplate x:DataType="vm:ShapeOption">
					<StackPanel Width="100" Spacing="4">
						<Border Height="72" CornerRadius="4" ClipToBounds="True"
								IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}">
							<Image Source="{Binding Icon}" Stretch="Uniform"/>
						</Border>
						<TextBlock Text="{Binding Title}" HorizontalAlignment="Center"
								   TextWrapping="Wrap" TextAlignment="Center"/>
					</StackPanel>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

		<Separator/>

		<!-- Прямоугольник -->
		<Grid Classes="form" RowDefinitions="Auto,Auto" IsVisible="{Binding IsRectangle}"  ColumnDefinitions="220, Auto">
			<TextBlock Classes="caption" Grid.Row="0" Text="Ширина, мм"/>
			<NumericUpDown Grid.Row="0" Value="{Binding RectWidth}" Minimum="50" Maximum="10000" Increment="10" FormatString="0.##"/>
			<TextBlock Classes="caption" Grid.Row="1" Text="Высота, мм"/>
			<NumericUpDown Grid.Row="1" Value="{Binding RectHeight}" Minimum="50" Maximum="10000" Increment="10" FormatString="0.##"/>
		</Grid>

		<!-- Трапеция -->
		<Grid Classes="form" RowDefinitions="Auto,Auto,Auto,Auto" IsVisible="{Binding IsTrapezoid}"  ColumnDefinitions="220, Auto">
			<TextBlock Classes="caption" Grid.Row="0" Text="Широкое основание, мм"/>
			<NumericUpDown Grid.Row="0" Value="{Binding TrapBaseWidth}" Minimum="50" Maximum="10000" Increment="10" FormatString="0.##"/>
			<TextBlock Classes="caption" Grid.Row="1" Text="Узкое основание, мм"/>
			<NumericUpDown Grid.Row="1" Value="{Binding TrapNarrowWidth}" Minimum="10" Maximum="10000" Increment="10" FormatString="0.##"/>
			<TextBlock Classes="caption" Grid.Row="2" Text="Высота, мм"/>
			<NumericUpDown Grid.Row="2" Value="{Binding TrapHeight}" Minimum="50" Maximum="10000" Increment="10" FormatString="0.##"/>
			<TextBlock Classes="caption" Grid.Row="3" Text="Расположение узкого основания"/>
			<ComboBox Grid.Row="3" ItemsSource="{Binding Sides}" SelectedItem="{Binding TrapSide}">
				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="vm:SideOption">
						<TextBlock Text="{Binding Title}"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
		</Grid>

		<!-- Овал / круг -->
		<StackPanel Spacing="8" IsVisible="{Binding IsEllipse}">
			<Grid Classes="form" RowDefinitions="Auto,Auto,Auto"  ColumnDefinitions="220, Auto">
				<TextBlock Classes="caption" Grid.Row="0" Text="Количество досок"/>
				<ComboBox Grid.Row="0" ItemsSource="{Binding BoardCounts}" SelectedItem="{Binding OvalBoards}"/>
				<TextBlock Classes="caption" Grid.Row="1" Text="Радиус по горизонтали, мм"/>
				<NumericUpDown Grid.Row="1" Value="{Binding RadiusHorizontal}" Minimum="25" Maximum="5000" Increment="10" FormatString="0.##"/>
				<TextBlock Classes="caption" Grid.Row="2" Text="Радиус по вертикали, мм"/>
				<NumericUpDown Grid.Row="2" Value="{Binding RadiusVertical}" Minimum="25" Maximum="5000" Increment="10" FormatString="0.##"/>
			</Grid>
			<TextBlock Classes="hint" Text="{Binding OvalInfo}"/>
			<TextBlock Classes="hint" Text="Одинаковые радиусы дают круг. При 2 и 3 досках возможен только круг."/>
		</StackPanel>

		<!-- Многоугольник -->
		<Grid Classes="form" RowDefinitions="Auto,Auto" ColumnDefinitions="220, Auto" IsVisible="{Binding IsPolygon}">
			<TextBlock Classes="caption" Grid.Row="0" Text="Количество сторон"/>
			<NumericUpDown Grid.Row="0" Value="{Binding PolySides}" Minimum="3" Maximum="64" Increment="1" FormatString="0"/>
			<TextBlock Classes="caption" Grid.Row="1" Text="Длина стороны, мм"/>
			<NumericUpDown Grid.Row="1" Value="{Binding PolySideLength}" Minimum="10" Maximum="5000" Increment="10" FormatString="0.##"/>
		</Grid>

		<TextBlock Text="{Binding Error}" Foreground="#C62828" TextWrapping="Wrap"
				   IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
			<Button Content="Создать" IsDefault="True" Click="Ok_Click"/>
			<Button Content="Отмена" IsCancel="True" Click="Cancel_Click"/>
		</StackPanel>
	</StackPanel>
</Window>