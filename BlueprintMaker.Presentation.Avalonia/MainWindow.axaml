<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="using:BlueprintMaker.Presentation.Avalonia.ViewModels"
		xmlns:views="using:BlueprintMaker.Presentation.Avalonia.Views"
		xmlns:mat="using:BlueprintMaker.Domain.Models.Materialisation"
		mc:Ignorable="d"
		x:Class="BlueprintMaker.Presentation.Avalonia.MainWindow"
		x:DataType="vm:MainViewModel"
		Title="Конструктор"
		WindowStartupLocation="CenterOwner"
		WindowState="Maximized">

	<Design.DataContext>
		<vm:MainViewModel/>
	</Design.DataContext>

	<Grid RowDefinitions="Auto, Auto, *" ColumnDefinitions="*, 4*, *">

		<!-- Меню -->
		<Menu Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
			<MenuItem Header="Файл">
				<MenuItem Header="Создать окно" Command="{Binding CreateWindowCommand}"/>
				<MenuItem Header="Создать окно-трапецию" Command="{Binding CreateWindowTCommand}"/>
				<MenuItem Header="Создать окно-шестрагранник" Command="{Binding CreateWindowHCommand}"/>
			</MenuItem>
		</Menu>

		<!-- Панель инструментов -->
		<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5" Spacing="5" Grid.Column="0" Grid.ColumnSpan="3">
			<Button Content="Undo" Command="{Binding UndoCommand}" Padding="10,2"/>
			<Button Content="Redo" Command="{Binding RedoCommand}" Padding="10,2"/>
			<Button Content="Материализовать" Command="{Binding MaterializeCommand}" Padding="10,2"/>
			<Button Content="Вставить вертикальный импост" Command="{Binding InsertVerticalImpostCommand}" Padding="10,2"/>
			<Button Content="Вставить горизонтальный импост" Command="{Binding InsertHorizontalImpostCommand}" Padding="10,2"/>
			<Button Content="Вставить 3 Импоста" Command="{Binding InsertMultipleImpostsCommand}" Padding="10,2"/>
			<Separator Margin="10,0"/>

			<!-- Инструменты стыков -->
			<TextBlock Text="Стыки:" VerticalAlignment="Center" Margin="5,0"/>
			<Button Content="На ус (45°)" Command="{Binding SetJointTypeCommand}" CommandParameter="{x:Static mat:JointEndType.Miter}" Padding="10,2"/>
			<Button Content="Шип-Паз" Command="{Binding SetJointTypeCommand}" CommandParameter="{x:Static mat:JointEndType.Tenon}" Padding="10,2"/>

			<Separator Margin="10,0"/>

			<TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="10,0,0,0"/>
		</StackPanel>

		<!-- Дерево элементов -->
		<TreeView Grid.Row="2" Grid.Column="0" ItemsSource="{Binding Frames}" Background="WhiteSmoke">
			<TreeView.ItemTemplate>
				<TreeDataTemplate DataType="vm:FrameViewModel" ItemsSource="{Binding Children}">
					<Button Command="{Binding SelectCommand}" CommandParameter="{Binding}"
							Padding="2" Background="Transparent" BorderThickness="0">
						<TextBlock Text="{Binding DisplayName}" Foreground="{Binding DisplayColor}" />
					</Button>
				</TreeDataTemplate>
			</TreeView.ItemTemplate>
		</TreeView>

		<!-- Холст -->
		<ItemsControl x:Name="DrawingCanvas" Grid.Row="2" Grid.Column="1" Background="LightGray" ItemsSource="{Binding Frames}">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="LightGray"/>
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>

			<ItemsControl.Styles>
				<Style Selector="ItemsControl > ContentPresenter">
					<Setter Property="Canvas.Left" Value="0"/>
					<Setter Property="Canvas.Top" Value="0"/>
					<Setter Property="HorizontalAlignment" Value="Stretch"/>
					<Setter Property="VerticalAlignment" Value="Stretch"/>
				</Style>
			</ItemsControl.Styles>

			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="vm:FrameViewModel">
					<Panel HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="1500" MinHeight="1500">

						<!-- Скелет -->
						<ItemsControl ItemsSource="{Binding Lines}" IsVisible="{Binding !IsMaterialized}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.Styles>
								<Style Selector="ItemsControl > ContentPresenter">
									<Setter Property="Canvas.Left" Value="0"/>
									<Setter Property="Canvas.Top" Value="0"/>
								</Style>
							</ItemsControl.Styles>
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="vm:WireframeLine">
									<Path Data="{Binding Geometry}"
										  Stroke="{Binding StrokeColor}"
										  StrokeThickness="{Binding StrokeThickness}"
										  Fill="Transparent"
										  PointerPressed="ElementPath_PointerPressed"/>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

						<!-- Доски -->
						<ItemsControl ItemsSource="{Binding Boards}" IsVisible="{Binding IsMaterialized}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.Styles>
								<Style Selector="ItemsControl > ContentPresenter">
									<Setter Property="Canvas.Left" Value="0"/>
									<Setter Property="Canvas.Top" Value="0"/>
								</Style>
							</ItemsControl.Styles>
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="vm:BoardViewModel">
									<Path Data="{Binding Geometry}"
										  Fill="{Binding FillColor}"
										  Stroke="Black"
										  StrokeThickness="1"
										  PointerPressed="ElementPath_PointerPressed"/>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>


						<ItemsControl ItemsSource="{Binding Spaces}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.Styles>
								<Style Selector="ItemsControl > ContentPresenter">
									<Setter Property="Canvas.Left" Value="0"/>
									<Setter Property="Canvas.Top" Value="0"/>
								</Style>
							</ItemsControl.Styles>
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="vm:LightSpaceViewModel">
									<Path Data="{Binding Geometry}"
										  Fill="{Binding FillColor}"
										  Stroke="Transparent"
										  StrokeThickness="1"
										  PointerPressed="ElementPath_PointerPressed"/>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

						<!-- Импосты -->
						<ItemsControl ItemsSource="{Binding Imposts}" IsVisible="{Binding !IsMaterialized}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.Styles>
								<Style Selector="ItemsControl > ContentPresenter">
									<Setter Property="Canvas.Left" Value="0"/>
									<Setter Property="Canvas.Top" Value="0"/>
								</Style>
							</ItemsControl.Styles>
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="vm:ImpostViewModel">
									<Path Data="{Binding Geometry}"
										  Stroke="{Binding StrokeColor}"
										  StrokeThickness="{Binding StrokeThickness}"
										  Cursor="{Binding DragCursor}"
										  PointerPressed="ElementPath_PointerPressed"/>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

						<!-- Узлы (Nodes) -->
						<ItemsControl ItemsSource="{Binding Nodes}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<Canvas />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.Styles>
								<Style Selector="ItemsControl > ContentPresenter">
									<Setter Property="Canvas.Left" Value="{ReflectionBinding X}"/>
									<Setter Property="Canvas.Top" Value="{ReflectionBinding Y}"/>
								</Style>
							</ItemsControl.Styles>
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="vm:NodeViewModel">
									<Ellipse Width="12" Height="12"
											 Fill="{Binding FillColor}"
											 Stroke="Black"
											 StrokeThickness="1"
											 Margin="-6,-6,0,0"
											 PointerPressed="Node_PointerPressed"/>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

					</Panel>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

	</Grid>
</Window>
