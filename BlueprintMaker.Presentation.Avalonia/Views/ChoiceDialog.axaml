<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BlueprintMaker.Presentation.Avalonia.Views.ChoiceDialog"
        Title="BlueprintMaker"
        Width="420" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="YesButton" IsDefault="True" Click="Yes_Click"/>
            <Button x:Name="NoButton" Click="No_Click"/>
            <Button x:Name="CancelButton" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>